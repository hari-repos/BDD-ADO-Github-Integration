{
  "name": "bdd-canvas-backend",
  "version": "1.0.0",
  "description": "Azure Function to securely sync BDD Canvas files from Azure DevOps to GitHub",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@octokit/rest": "^20.0.0",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^3.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^18.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  }
}
