{
  "manifestVersion": 1,
  "id": "bdd-canvas-for-boards",
  "publisher": "HaritharanPrabalanathan",
  "version": "1.0.2",
  "name": "BDD Canvas for Boards",
  "description": "A collaborative canvas to write and edit BDD scenarios directly in Azure Boards, bridging the gap between business and code by syncing to GitHub.",
  "public": false,
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "icons": {
    "default": "images/logo.png"
  },
  "categories": [
    "Azure Boards"
  ],
  "content": {
    "details": {
      "path": "README.md"
    }
  },
  "scopes": [
    "vso.work",
    "vso.work_write",
    "vso.profile"
  ],
  "contributions": [
    {
      "id": "bdd-gherkin-tab",
      "type": "ms.vss-work-web.work-item-form-page",
      "targets": [
        "ms.vss-work-web.work-item-form"
      ],
      "properties": {
        "name": "BDD Canvas",
        "uri": "dist/index.html",
        "icon": "images/tab-icon.png"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "images",
      "addressable": true
    },
    {
      "path": "README.md",
      "addressable": false
    }
  ]
}